# Copiar a .env y ajustar. Nunca commitear el .env real.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# SQLite por defecto. Para Postgres:
# DATABASE_URL=postgresql+psycopg://arca:arca@localhost:5432/arca_sync
DATABASE_URL=sqlite:///./arca_sync.db

# Seguridad (generar con: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-in-production-please-32b
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
OAUTH_CLIENT_ID=integration-client
OAUTH_CLIENT_SECRET=integration-secret
OAUTH_CLIENT_SCOPES="sync:write comprobantes:read monitoring:read"

# ARCA (por defecto apunta al mock local)
ARCA_BASE_URL=http://127.0.0.1:5001
ARCA_CUIT=20123456789
ARCA_AUTH_MODE=token
ARCA_STATIC_TOKEN=dev-token
ARCA_PAGE_SIZE=100
SYNC_INITIAL_DATE=2026-01-01

# Receptor
RECEPTOR_BASE_URL=http://127.0.0.1:5001/receptor
RECEPTOR_API_KEY=receptor-dev-key

# Webhooks entrantes del receptor (secreto HMAC compartido)
WEBHOOK_SECRET=webhook-dev-secret
WEBHOOK_TOLERANCE_SECONDS=300

# Reintentos (backoff exponencial con jitter)
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=30

# Scheduler interno
SCHEDULER_ENABLED=false
SYNC_INTERVAL_MINUTES=15
MONITORING_INTERVAL_SECONDS=60

# Monitoreo
HOSTS_CONFIG_PATH=config/hosts.yaml
CPU_WARNING=80
CPU_CRITICAL=95
MEMORY_WARNING=80
MEMORY_CRITICAL=95
DISK_WARNING=80
DISK_CRITICAL=90
ALERT_COOLDOWN_MINUTES=15

# Notificaciones (opcionales)
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=monitor@example.com
ALERT_EMAIL_TO=
